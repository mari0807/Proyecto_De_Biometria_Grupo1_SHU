<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio"
    android:paddingTop="@dimen/espacio_pequeno"
    android:paddingEnd="@dimen/espacio">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_password_aviso"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/password_valor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/campo_fondo"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_copiar_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/admin_btn_copiar" />

</LinearLayout>
