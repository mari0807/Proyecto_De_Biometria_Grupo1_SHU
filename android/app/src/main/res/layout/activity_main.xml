<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Cabecera: título del mapa y cierre de sesión. El padding superior lo
         fija MainActivity con el alto real de la barra de estado (notificaciones
         y cámara del móvil), que cambia según el dispositivo. -->
    <LinearLayout
        android:id="@+id/mapa_cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/espacio"
        android:paddingTop="@dimen/espacio_pequeno"
        android:paddingEnd="@dimen/espacio"
        android:paddingBottom="@dimen/espacio_pequeno">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mapa_titulo"
                android:textColor="@android:color/white"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mapa_subtitulo"
                android:textColor="#D6EAF8"
                android:textSize="@dimen/texto_pequeno" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/btn_logout"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mapa con sus capas flotantes. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.osmdroid.views.MapView
            android:id="@+id/mapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Aviso de error (con botón de reintento debajo). -->
        <TextView
            android:id="@+id/mapa_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio"
            android:layout_marginTop="@dimen/espacio"
            android:layout_marginEnd="@dimen/espacio"
            android:background="@drawable/panel_blanco"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_pequeno"
            android:visibility="gone" />

        <!-- Leyenda levantada para que no la tape el mensaje inferior. -->
        <com.grupo1.biometria.mapa.LeyendaView
            android:id="@+id/mapa_leyenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/espacio"
            android:layout_marginBottom="56dp"
            android:background="@drawable/panel_blanco"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/mapa_actualizacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/espacio"
            android:background="@drawable/panel_blanco"
            android:textColor="@color/ink"
            android:textSize="@dimen/texto_pequeno" />

        <ProgressBar
            android:id="@+id/mapa_cargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/mapa_reintentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/mapa_reintentar"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
